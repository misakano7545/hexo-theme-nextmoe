
.nexmoe-page-nav > * {
    margin-right: 8px;
    float: none;
    color: var(--color-text-2);
    border-radius: 50%;
    width: 36px;
    height: 36px;
    line-height: 36px;
    background: var(--color-subtle);
}

.nexmoe-page-nav {
    list-style: none;
    color: #ddd;
    text-align: center;
    justify-content: center;
    margin-top: 48px;
    display: flex;

    .prev {
        margin-left: 8px;
    }

    .current {
        color: #fff;
        background: var(--color-link);
        opacity: 1;
        box-shadow: none;
    }
}
