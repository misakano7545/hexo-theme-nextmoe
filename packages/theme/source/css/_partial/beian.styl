.nexmoe-beian {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 6px 14px;
    margin-top: 8px;
    padding: 18px 16px 24px;
    border-top: 1px solid rgba(127, 127, 127, 0.18);
    font-size: 12px;
    line-height: 2;
    color: #767676;

    a {
        color: inherit;
        transition: color 0.2s;

        &:hover {
            color: var(--color-primary);
        }
    }
}

/* 桌面端放侧栏，移动端放页脚，避免同一屏出现两次 */
.nexmoe-copyright .nexmoe-beian {
    margin-top: 6px;
    padding: 0;
    border-top: none;
    gap: 2px 10px;
    font-size: 11px;
    line-height: 1.8;
}

@media (min-width: 1025px) {
    #nexmoe-footer .nexmoe-beian {
        display: none;
    }
}
