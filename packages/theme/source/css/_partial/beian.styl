.nexmoe-beian {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 6px 14px;
    margin-top: 8px;
    padding: 18px 16px 24px;
    border-top: 1px solid rgba(127, 127, 127, 0.18);
    font-size: 12px;
    line-height: 2;
    color: #767676;

    a {
        color: inherit;
        transition: color 0.2s;

        &:hover {
            color: var(--color-primary);
        }
    }
}
