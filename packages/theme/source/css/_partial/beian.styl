.nexmoe-beian {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 6px 14px;
    padding: 18px 16px 24px;
    font-size: 12px;
    line-height: 2;
    color: #999;

    a {
        color: inherit;
        transition: color 0.2s;

        &:hover {
            color: var(--color-primary);
        }
    }
}
