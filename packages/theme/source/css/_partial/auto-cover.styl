// 默认头图：明亮几何底 + 描边贴纸标题 + 圆形贴纸徽章
// 色相仍由标题哈希决定（同一篇每次构建一致），但限制在黄绿→青绿区间，
// 让所有默认头图共用一个「贴纸」语言，又不会十张一模一样。
.nexmoe-post .nexmoe-post-cover.nexmoe-auto-cover {
    --cover-h: calc(78 + var(--cover-hue) * 0.25);
    --cover-base: unquote("hsl(var(--cover-h), 78%, 50%)");
    --cover-band: unquote("hsl(var(--cover-h), 88%, 66%)");
    --cover-strip: unquote("hsl(var(--cover-h), 62%, 38%)");
    --cover-ink: unquote("hsl(var(--cover-h), 88%, 15%)");
    --cover-cream: #fbf7d3;

    display: flex;
    align-items: center;
    min-height: 220px;
    padding-top: 0;
    background-color: var(--cover-base);
    background-image:
        radial-gradient(circle 150px at 97% 2%, rgba(255, 255, 255, 0.16) 99%, transparent 100%),
        radial-gradient(circle 96px at 87% 20%, rgba(255, 255, 255, 0.22) 99%, transparent 100%),
        radial-gradient(circle 124px at 5% 105%, rgba(255, 255, 255, 0.14) 99%, transparent 100%),
        linear-gradient(to bottom, var(--cover-base) 0 17%, var(--cover-band) 17% 76%, var(--cover-strip) 76% 100%);
    background-size: cover;

    // 斜纹 + 左下角奶油色楔形
    &::before {
        content: '';
        position: absolute;
        inset: 0;
        background-image:
            conic-gradient(from -34deg at -8% 98%, rgba(251, 247, 211, 0.5) 0 30deg, transparent 30deg),
            repeating-linear-gradient(112deg, rgba(255, 255, 255, 0.14) 0 1px, transparent 1px 24px);
        pointer-events: none;
    }

    h1 {
        position: relative;
        z-index: 2;
        width: 62%;
        box-sizing: border-box;
        margin: 0;
        padding: 0 0 0 5%;
        font-size: clamp(1.35rem, 3vw, 2.5rem);
        line-height: 1.2;
        letter-spacing: 0;
        color: var(--cover-cream);
        -webkit-text-stroke: 4px var(--cover-ink);
        paint-order: stroke fill;
        text-shadow: 0 5px 0 rgba(0, 0, 0, 0.14);
    }

    // list.styl 给 h1:after 铺了黑色渐变压底，配浅色头图会变脏
    h1:after {
        content: none;
    }

    .nexmoe-cover-badge {
        position: absolute;
        right: 5%;
        top: 50%;
        height: 78%;
        aspect-ratio: 1;
        transform: translateY(-50%);
        border-radius: 50%;
        background: #fff;
        box-shadow: 0 0 0 3px var(--cover-base), 0 10px 20px rgba(31, 41, 55, 0.22);
        z-index: 1;

        img {
            position: static;
            display: block;
            width: 100%;
            height: 100%;
            border: 6px solid #fff;
            border-radius: 50%;
            box-sizing: border-box;
            object-fit: cover;
        }
    }
}

@media (max-width: 600px) {
    .nexmoe-post .nexmoe-post-cover.nexmoe-auto-cover {
        h1 {
            width: 54%;
            font-size: 1.15rem;
            -webkit-text-stroke: 2.5px var(--cover-ink);
        }

        .nexmoe-cover-badge {
            height: 58%;
            right: 4%;
        }
    }
}
