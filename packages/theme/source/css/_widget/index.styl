.nexmoe-widget-wrap {
    box-shadow: var(--shadow-card);
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    margin: 16px 20px;
    border-radius: 14px;
    overflow: hidden;
    white-space: normal;

    .nexmoe-widget-title {
        font-size: 12px;
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        padding: 20px 18px 10px;
        margin: 0;
        color: var(--color-text-3);
    }

    .nexmoe-widget {
        ul {
            list-style-type: none;
            padding: 0 0 6px;
            margin: 0;

            li {
                overflow: hidden;
                text-overflow: ellipsis;
                white-space: nowrap;
                position: relative;
                padding: 9px 18px;
                font-size: 14px;
                /* 给右侧计数圆点留位，长分类名不再压到数字下面。 */
                padding-right: 52px;

                a {
                    color: var(--color-text-2);
                    display: block;
                    overflow: hidden;
                    text-overflow: ellipsis;
                }

                a:hover {
                    color: var(--color-primary);
                }
            }

            li:last-child {
                border-bottom: none;
                padding-bottom: 16px;
            }
        }

        .category-list-count, .archive-list-count {
            background-color: var(--color-subtle);
            display: inline-block;
            width: 22px;
            height: 22px;
            line-height: 22px;
            font-size: 12px;
            text-align: center;
            border-radius: 6px;
            color: var(--color-text-3);
            position: absolute;
            right: 18px;
            top: 10px;
        }
    }

    .tagcloud {
        padding: 8px 14px 14px;

        a {
            border-radius: 6px;
            padding: 4px 8px;
            font-size: 12px !important;
            display: inline-block;
            margin-bottom: 4px;
        }

        a:before {
            content: '# ';
        }
    }

    .nexmoe-search {
        input {
            border: none !important;
            background-color: transparent;
            padding: 18px;
            font-size: 14px;
            box-sizing: border-box;
            outline: none;
        }
    }

    input::-webkit-search-decoration, input::-webkit-search-cancel-button {
        display: none !important;
    }

    .nexmoe-social {
        padding: 10px;
        font-size: 0;

        a {
            width: 38px;
            height: 38px;
            line-height: 38px;
            margin: 4px;
            border-radius: 100%;
            display: inline-block;
            text-align: center;
            color: var(--color-text-2);
        }
    }
}

.nexmoe-widget-wrap:first-child {
    margin-top: 0;
}
@media screen and (max-width: 1024px) {
    #nexmoe-header .nexmoe-social a {
        margin: 5px;
        width: 44px;
        height: 44px;
        line-height: 44px;
    }
}