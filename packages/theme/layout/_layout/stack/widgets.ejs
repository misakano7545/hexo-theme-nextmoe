<%
var widgetNames = (theme.widgets || []).filter(function (w) { return w.enable !== false; }).map(function (w) { return w.name; });
var hasSearch = widgetNames.indexOf('search') > -1;
var hasArchive = widgetNames.indexOf('archive') > -1;
var hasTag = widgetNames.indexOf('tagcloud') > -1;
var HASH = '<svg class="icon icon-tabler icon-tabler-hash" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><line x1="5" y1="9" x2="19" y2="9"/><line x1="5" y1="15" x2="19" y2="15"/><line x1="11" y1="4" x2="7" y2="20"/><line x1="17" y1="4" x2="13" y2="20"/></svg>';
var TAGICON = '<svg class="icon icon-tabler icon-tabler-tag" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M11 3l9 9a1.5 1.5 0 010 2l-6 6a1.5 1.5 0 01-2 0L3 11V7a4 4 0 014-4h4"/><circle cx="9" cy="9" r="2"/></svg>';
var CAL = '<svg class="icon icon-tabler icon-tabler-calendar" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><rect x="4" y="5" width="16" height="16" rx="2"/><line x1="16" y1="3" x2="16" y2="7"/><line x1="8" y1="3" x2="8" y2="7"/><line x1="4" y1="11" x2="20" y2="11"/></svg>';
var SEARCH = '<svg class="icon icon-tabler icon-tabler-search" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><circle cx="10" cy="10" r="7"/><line x1="21" y1="21" x2="15" y2="15"/></svg>';

var years = {};
site.posts.each(function (post) { var y = post.date.year(); years[y] = (years[y] || 0) + 1; });
var yearList = Object.keys(years).sort(function (a, b) { return b - a; });
%>
<% if (hasSearch) { %>
<form class="search-form widget" onsubmit="return false;">
    <p>
        <label>搜索</label>
        <input id="search_value" name="keyword" required placeholder="输入关键词…">
        <button type="button" title="搜索" onclick="openSearch(document.getElementById('search_value').value)"><%- SEARCH %></button>
    </p>
</form>
<% } %>
<% if (hasArchive && yearList.length) { %>
<section class="widget archives">
    <div class="widget-icon"><%- CAL %></div>
    <h2 class="widget-title section-title">归档</h2>
    <div class="widget-archive--list">
        <% yearList.forEach(function (year) { %>
        <div class="archives-year"><a href="<%- url_for('/archives/') %>#<%= year %>"><span class="year"><%= year %></span><span class="count"><%= years[year] %></span></a></div>
        <% }); %>
    </div>
</section>
<% } %>
<% if (hasTag && site.categories.length) { %>
<section class="widget tagCloud">
    <div class="widget-icon"><%- HASH %></div>
    <h2 class="widget-title section-title">分类</h2>
    <div class="tagCloud-tags">
        <% site.categories.sort('count', -1).limit(10).each(function (cat) { %>
        <a href="<%- url_for(cat.path) %>"><%= cat.name %></a>
        <% }); %>
    </div>
</section>
<% } %>
<% if (hasTag && site.tags.length) { %>
<section class="widget tagCloud">
    <div class="widget-icon"><%- TAGICON %></div>
    <h2 class="widget-title section-title">标签</h2>
    <div class="tagCloud-tags">
        <% site.tags.sort('count', -1).limit(10).each(function (tag) { %>
        <a href="<%- url_for(tag.path) %>"><%= tag.name %></a>
        <% }); %>
    </div>
</section>
<% } %>
