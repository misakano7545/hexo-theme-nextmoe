<%
/* Tabler 图标（与 hugo-theme-stack 同一套描边图标） */
var ICONS = {
    home: '<polyline points="5 12 3 12 12 3 21 12 19 12"/><path d="M5 12v7a2 2 0 002 2h10a2 2 0 002-2v-7"/><path d="M9 21v-6a2 2 0 012-2h2a2 2 0 012 2v6"/>',
    book: '<path d="M3 19a9 9 0 019 0 9 9 0 019 0"/><path d="M3 6a9 9 0 019 0 9 9 0 019 0"/><path d="M3 6v13"/><path d="M12 6v13"/><path d="M21 6v13"/>',
    archive: '<rect x="3" y="4" width="18" height="4" rx="2"/><path d="M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8"/><line x1="10" y1="12" x2="14" y2="12"/>',
    tag: '<path d="M11 3l9 9a1.5 1.5 0 010 2l-6 6a1.5 1.5 0 01-2 0L3 11V7a4 4 0 014-4h4"/><circle cx="9" cy="9" r="2"/>',
    'info-circle': '<path d="M3 12a9 9 0 1 0 18 0a9 9 0 0 0 -18 0"/><path d="M12 9h.01"/><path d="M11 12h1v4h1"/>',
    github: '<path d="M9 19c-4.3 1.4-4.3-2.5-6-3m12 5v-3.5c0-1 .1-1.4-.5-2 2.8-.3 5.5-1.4 5.5-6a4.6 4.6 0 00-1.3-3.2 4.2 4.2 0 00-.1-3.2s-1.1-.3-3.5 1.3a12.3 12.3 0 00-6.2 0C6.5 2.8 5.4 3.1 5.4 3.1a4.2 4.2 0 00-.1 3.2A4.6 4.6 0 004 9.5c0 4.6 2.7 5.7 5.5 6-.6.6-.6 1.2-.5 2V21"/>',
    bilibili: '<path d="M3 10a4 4 0 014-4h10a4 4 0 014 4v6a4 4 0 01-4 4H7a4 4 0 01-4-4v-6z"/><path d="M8 3l2 3"/><path d="M16 3l-2 3"/><path d="M9 13v-2"/><path d="M15 11v2"/>',
    rss: '<path d="M4 19a1 1 0 102 0a1 1 0 10-2 0"/><path d="M4 4a16 16 0 0116 16"/><path d="M4 11a9 9 0 019 9"/>',
    mail: '<path d="M3 7a2 2 0 012-2h14a2 2 0 012 2v10a2 2 0 01-2 2H5a2 2 0 01-2-2V7z"/><path d="M3 7l9 6 9-6"/>',
    link: '<path d="M10 13a5 5 0 007 0l3-3a5 5 0 00-7-7l-1 1"/><path d="M14 11a5 5 0 00-7 0l-3 3a5 5 0 007 7l1-1"/>',
    'toggle-left': '<circle cx="8" cy="12" r="2"/><rect x="2" y="6" width="20" height="12" rx="6"/>',
    'toggle-right': '<circle cx="16" cy="12" r="2"/><rect x="2" y="6" width="20" height="12" rx="6"/>'
};

function svg(name) {
    return '<svg class="icon icon-tabler icon-tabler-' + name + '" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/>' + (ICONS[name] || ICONS.link) + '</svg>';
}

var MENU_ICON = { 'icon-home': 'home', 'icon-calendar-fill': 'archive', 'icon-tag-fill': 'tag', 'icon-info-circle': 'info-circle' };
var socialWidget = (theme.widgets || []).filter(function (w) { return w.name === 'social' && w.enable !== false; })[0];
var socials = (socialWidget && socialWidget.options && socialWidget.options.social) || {};
var curPath = ('/' + (page.path || '')).replace(/index\.html$/, '');
%>
<button class="hamburger hamburger--spin" type="button" id="toggle-menu" aria-label="切换菜单">
    <span class="hamburger-box"><span class="hamburger-inner"></span></span>
</button>
<header>
    <figure class="site-avatar">
        <a href="<%- url_for('/') %>"><img src="<%- url_for(theme.avatar) %>" width="300" height="300" class="site-logo" alt="Avatar"></a>
    </figure>
    <div class="site-meta">
        <h1 class="site-name"><a href="<%- url_for('/') %>"><%= config.title %></a></h1>
        <h2 class="site-description"><%= config.subtitle || config.description %></h2>
    </div>
</header>
<% if (Object.keys(socials).length) { %>
<ol class="menu-social">
    <% Object.keys(socials).forEach(function (name) {
        var link = socials[name][0];
        var key = /github/i.test(link + name) ? 'github' : (/bilibili|哔哩/i.test(link + name) ? 'bilibili' : (/rss|atom/i.test(link + name) ? 'rss' : (/mail|@/i.test(link) ? 'mail' : 'link')));
    %>
    <li><a href="<%- url_for(link) %>" target="_blank" rel="me" title="<%= name %>"><%- svg(key) %></a></li>
    <% }); %>
</ol>
<% } %>
<ol class="menu" id="main-menu">
    <% Object.keys(theme.menu).forEach(function (name) {
        var path = theme.menu[name][0];
        var icon = MENU_ICON[theme.menu[name][1]] || 'book';
    %>
    <li<% if (url_for(path) === curPath) { %> class="current"<% } %>><a href="<%- url_for(path) %>"><%- svg(icon) %><span><%= name %></span></a></li>
    <% }); %>
    <li class="menu-bottom-section">
        <ol class="menu">
            <li id="dark-mode-toggle">
                <%- svg('toggle-left') %><%- svg('toggle-right') %><span>深色模式</span>
            </li>
        </ol>
    </li>
</ol>
