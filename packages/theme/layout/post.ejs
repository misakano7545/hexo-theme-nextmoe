<%
var cover = page.cover || (page.photos && page.photos[0]);
var CALENDAR = '<svg class="icon icon-tabler icon-tabler-calendar-time" width="56" height="56" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M11.795 21H5a2 2 0 01-2-2V7a2 2 0 012-2h12a2 2 0 012 2v4"/><circle cx="18" cy="18" r="4"/><path d="M15 3v4"/><path d="M7 3v4"/><path d="M3 11h16"/><path d="M18 16.496V18l1 1"/></svg>';
var CLOCK = '<svg class="icon icon-tabler icon-tabler-clock" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><circle cx="12" cy="12" r="9"/><polyline points="12 7 12 12 15 15"/></svg>';
var CC = '<svg class="icon icon-tabler icon-tabler-copyright" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><circle cx="12" cy="12" r="9"/><path d="M14.5 9a3.5 3.5 0 100 6"/></svg>';
var minutes = Math.max(1, Math.ceil(strip_html(page.content).length / 400));
%>
<article class="main-article<%- cover ? ' has-image' : '' %>">
    <header class="article-header">
        <% if (cover) { %>
        <div class="article-image">
            <a href="<%- url_for(page.path) %>"><img src="<%- url_for(cover) %>" loading="lazy" alt="<%= page.title %>"></a>
        </div>
        <% } %>
        <div class="article-details">
            <% var cats = (page.categories && page.categories.length) ? page.categories : (page.tags && page.tags.length ? [page.tags.first()] : null); %>
            <% if (cats) { %>
            <header class="article-category"><% cats.forEach(function (c) { %><a href="<%- url_for(c.path) %>"><%= c.name %></a><% }); %></header>
            <% } %>
            <div class="article-title-wrapper">
                <h2 class="article-title"><a href="<%- url_for(page.path) %>"><%= page.title %></a></h2>
                <% if (page.description) { %><h3 class="article-subtitle"><%= page.description %></h3><% } %>
            </div>
            <footer class="article-time">
                <div><%- CALENDAR %><time class="article-time--published"><%= date(page.date, 'YYYY年M月D日') %></time></div>
                <div><%- CLOCK %><time class="article-time--reading"><%= minutes %> 分钟</time></div>
            </footer>
        </div>
    </header>

    <section class="article-content">
        <%- page.content %>
        <%- theme.slotArticleEnd %>
    </section>

    <footer class="article-footer">
        <% if (page.tags && page.tags.length) { %>
        <section class="article-tags">
            <% page.tags.each(function (tag) { %>
            <a href="<%- url_for(tag.path) %>"><%= tag.name %></a>
            <% }); %>
        </section>
        <% } %>
        <% if (!page.reprint) { %>
        <section class="article-copyright"><%- CC %><span><%- theme.slotCopyright %></span></section>
        <% } %>
    </footer>

    <% if (theme.function.copyCode) { %>
    <%- js_auto_version('js/copy-codeblock') %>
    <% } %>
</article>
<% if (page.comments && theme.slotComment) { %>
<div class="article-comments"><%- theme.slotComment %></div>
<% } %>
