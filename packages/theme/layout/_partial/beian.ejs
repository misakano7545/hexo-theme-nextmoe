<% if (theme.beian && (theme.beian.icp || theme.beian.police)) { %>
<div class="nexmoe-beian">
    <% if (theme.beian.icp) { %>
    <a href="https://beian.miit.gov.cn/" target="_blank" rel="noopener"><%= theme.beian.icp %></a>
    <% } %>
    <% if (theme.beian.police) { %>
    <a href="https://www.beian.gov.cn/portal/registerSystemInfo?recordcode=<%= theme.beian.police.replace(/\D/g, '') %>" target="_blank" rel="noopener"><%= theme.beian.police %></a>
    <% } %>
</div>
<% } %>
