<% page.posts.each(function (page) { %>
    <div class="nexmoe-post">
        <a href="<%- url_for(page.path) %>">
            <% if (page.cover){ %>
                <div class="nexmoe-post-cover mdui-ripple absolute" style="padding-top: <%- page.coverHeight/page.coverWidth*100 %>%;"> 
                    <img src="<%- page.cover %>" alt="<%= page.title %>" loading="lazy">
                    <h1><%= page.title %></h1>
                </div>
            <% } else if (theme.function.autoCover) { %>
                <div class="nexmoe-post-cover mdui-ripple nexmoe-auto-cover" style="--cover-hue: <%= coverHue(page.title || page.path) %>;">
                    <h1><%= page.title %></h1>
                    <i class="nexmoe-cover-badge"><img src="<%= url_for(theme.avatar) %>" alt=""></i>
                    <% if (page.sticky) { %><b class="nexmoe-cover-pin">置顶</b><% } %>
                </div>
            <%}  else{ %>
                <div class="nexmoe-post-cover mdui-ripple"> 
                    <img src="<%- theme.background.path %>" alt="<%= page.title %>" loading="lazy">
                    <h1><%= page.title %></h1>
                </div>
            <% } %>
        </a>

        <%- partial('_partial/_post/meta', {page: page}) %>

        <article>
            <%- page.excerpt %>
        </article>
    </div>
<% }) %>