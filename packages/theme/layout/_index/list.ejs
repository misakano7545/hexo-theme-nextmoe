<% page.posts.each(function (page) { %>
    <div class="nexmoe-post">
        <a class="nexmoe-post-head" href="<%- url_for(page.path) %>">
            <h2><%= page.title %></h2>
            <% if (page.sticky) { %><b class="nexmoe-post-pin">置顶</b><% } %>
        </a>

        <div class="nexmoe-post-meta">
            <span><i class="nexmoefont icon-calendar-fill"></i><%- date(page.date, "YYYY-MM-DD") %></span>
            <% if (page.categories && page.categories.length){ %>
                <span><i class="nexmoefont icon-appstore-fill"></i><%= page.categories.data[0].name %></span>
            <% } %>
            <% if (theme.function.wordCount){ %>
                <span><i class="nexmoefont icon-areachart"></i><%- wordcount(page.content) %> 字</span>
            <% } %>
        </div>

        <div class="nexmoe-post-excerpt"><%- strip_html(page.excerpt || page.content).trim().substring(0, 200) %></div>

        <% if (page.tags && page.tags.length){ %>
            <div class="nexmoe-post-tags"><%- list_tags(page.tags, {show_count: false, style: false, separator: '', class: 'nexmoe-post-tag'}) %></div>
        <% } %>
    </div>
<% }) %>
